# Przykład lokalnej konfiguracji (skopiuj do .dev.vars — ten plik jest w .gitignore).
# Zawiera wyłącznie nazwy i placeholdery. NIE wklejaj prawdziwych sekretów do repozytorium ani do rozmów.

S3_ENDPOINT=https://REPLACE_WITH_ENDPOINT_FROM_YOUR_IDRIVE_E2_ACCOUNT
S3_REGION=REPLACE_WITH_REGION
S3_BUCKET=REPLACE_WITH_BUCKET
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
# Losowy sekret >= 32 znaki, np.: openssl rand -base64 48
SESSION_SIGNING_KEY=REPLACE_WITH_LONG_RANDOM_VALUE
APP_ORIGIN=http://localhost:8787

# Uwierzytelnianie administratora (Cloudflare Access) — wymagane w produkcji:
ACCESS_TEAM_DOMAIN=REPLACE_WITH_TEAM.cloudflareaccess.com
ACCESS_AUD=REPLACE_WITH_ACCESS_APPLICATION_AUD_TAG

# TYLKO lokalnie: pomija Access dla hosta localhost/127.0.0.1. Nigdy nie ustawiaj w produkcji.
# ENVIRONMENT=development
# DEV_ADMIN_EMAIL=dev@localhost
